# ETJ EtronJF8 環境變數設定範本 (.env.example)

# 專案環境
ENVIRONMENT=development
DEBUG=True

# 資料庫設定 (SQLite)
DATABASE_PATH=data/etronjf8.db
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_SYNCHRONOUS=FULL
SQLITE_JOURNAL_MODE=WAL

# 時區設定
DEFAULT_TIMEZONE_TAIPEI=Asia/Taipei
DEFAULT_TIMEZONE_TOKYO=Asia/Tokyo

# 安全與工作階段 (Session)
SESSION_COOKIE_NAME=etj_session
SESSION_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_IN_PRODUCTION
SESSION_MAX_AGE_SECONDS=86400
